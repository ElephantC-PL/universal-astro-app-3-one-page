---
import type { Lang } from "../i18n/config";
import { getTranslatedUrlFragment, useTranslations, getRouteFromTranslatedPath } from "../i18n/utils";
import HeaderLink from "./HeaderLink.astro";
import { getMenu } from "../utilities/sections";
import { VERSIONS, CURRENT_VERSION } from "../version.config";

const lang = Astro.currentLocale as Lang;
const t = useTranslations(lang);

const currentVersion = getRouteFromTranslatedPath(Astro.url) ?? [];
const version = VERSIONS.find(v => v === currentVersion[0]) || CURRENT_VERSION;
const menu =  await getMenu(lang, version);

---

{
    menu?.map(item => (
        <HeaderLink href={'#' + getTranslatedUrlFragment(lang, item)}>{t(`section.${item}`)}</HeaderLink>
    ))
}