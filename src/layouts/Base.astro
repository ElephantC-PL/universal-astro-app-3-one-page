---

import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import type { Lang } from '../i18n/config';
import "../assets/app.css";
import MenuDrawer from '../components/MenuDrawer.astro';

interface Props {
  title?: string;
  description?: string;  
  menu?: string[];
}
const lang = Astro.currentLocale as Lang;
const { title = "My Website", description = "", menu } = Astro.props;
---

<html lang={lang} data-theme="dark">
	<head>
		<BaseHead title={title} description={description} />		
	</head>

	<body>
		<MenuDrawer menu={menu}>
			 <Header menu={menu}/>				
			<main class="pt-20">				
				<slot/>
			</main>
			<Footer />
			<CookieConsent/>
		</MenuDrawer>
	</body>
	<script>
		const links = document.querySelectorAll('a[data-section]');
		const sections = document.querySelectorAll('section[id]');

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					const id = entry.target.getAttribute('id');
					const link = document.querySelector(`a[data-section="#${id}"]`);
					console.log('Intersecting:', id);
					links.forEach(link => link.classList.remove('bg-base-300'));
					link?.classList.add('bg-base-300');						
				});
			},
			{
				rootMargin: '-30% 0px -60% 0px',
				threshold: 0
			}
		);
			
		sections.forEach((section) => observer.observe(section));
	</script>
</html>
